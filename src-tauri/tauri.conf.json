{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiinaMashiro",
  "version": "0.5.2",
  "identifier": "ai.shiina.mashiro",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ShiinaMashiro",
        "width": 1121,
        "height": 655,
        "resizable": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "resources": { "../hosts": "hosts", "../sdk": "sdk" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4RjNGMkUzNDQ0QTYxRDgKUldUWVlVcEU0L0x6V0VNYzJKWlAzV0FwVjVQaTlGUnlabVFGdXh5SDdQQnpjYkNqU3h5RWVBVU4K",
      "endpoints": [
        "https://gitee.com/isluoxiaoxiwork/shiina-mashiro-update/raw/main/latest.json",
        "https://github.com/MoonSeaFishCat/shiina-mashiro/releases/latest/download/latest.json"
      ]
    }
  }
}
